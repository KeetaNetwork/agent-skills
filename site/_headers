# Cloudflare response headers for keeta.ai. This file configures the server and is not published.
# The llms file and the Compute docs allow any origin, so browser-based agents can fetch them.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/llms.txt
  Access-Control-Allow-Origin: *

# Keeta Compute docs: every page also has a .md twin that agents fetch as text.
/compute/*
  Access-Control-Allow-Origin: *

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
