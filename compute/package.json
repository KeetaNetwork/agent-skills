{
  "name": "keeta-compute",
  "private": true,
  "description": "Keeta Compute: a marketplace for AI inference capacity on Keeta. Control plane, router and relay, node agent, and the macOS app.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.json",
    "test": "npm test --workspaces --if-present",
    "test:e2e": "node --import tsx --test test/e2e.test.ts",
    "test:worker": "node --import tsx --test --test-timeout=300000 test/worker.test.ts",
    "test:live": "node --import tsx --test --test-concurrency=1 --test-timeout=900000 --test-force-exit test/live/*.test.ts",
    "live:deposit-address": "node --import tsx test/live/deposit-address.ts",
    "assets:pin": "npm run pin-assets -w @keeta-compute/fx --",
    "credits:create": "npm run create-credits -w @keeta-compute/fx",
    "fx:start": "npm start -w @keeta-compute/fx",
    "fx:publish": "npm run publish-metadata -w @keeta-compute/fx",
    "catalog:pin": "npm run catalog:pin -w @keeta-compute/provider --"
  },
  "devDependencies": {
    "@keetanetwork/keetanet-client": "0.18.7",
    "@noble/curves": "^1.9.7",
    "@types/node": "^22.13.4",
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0",
    "@x402/keeta": "2.28.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
